{
  "redirects": [
    { "source": "/quiz.html", "destination": "/", "permanent": false },
    { "source": "/funfact.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/rekomendasi/:slug", "destination": "/api/rekomendasi/:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "crons": [
    { "path": "/api/cron/generate-seo-pages", "schedule": "0 20 * * *" },
    { "path": "/api/cron/generate-social-post", "schedule": "30 20 * * *" }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "assets/**"
    }
  }
}
